* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

:root {
  --bg: #f4f7fb;
  --panel: #ffffff;
  --panel-alt: #eef4ff;
  --primary: #1d4ed8;
  --primary-dark: #1e3a8a;
  --secondary: #0f172a;
  --border: #dfe7f3;
  --muted: #64748b;
  --success: #15803d;
  --success-soft: #dcfce7;
  --warning: #b45309;
  --warning-soft: #fff7ed;
  --danger: #b91c1c;
  --danger-soft: #fee2e2;
  --info: #0f766e;
  --info-soft: #ccfbf1;
  --shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
}

html,
body {
  font-family: Arial, Helvetica, sans-serif;
  background: var(--bg);
  color: var(--secondary);
}

body {
  min-height: 100vh;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.login-screen {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  background: linear-gradient(135deg, #eef6ff 0%, #eef2ff 100%);
}

.login-panel {
  padding: 60px 40px;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.hero-panel {
  background: linear-gradient(180deg, rgba(29, 78, 216, 0.05), rgba(255, 255, 255, 0.15));
}

.badge {
  display: inline-flex;
  width: fit-content;
  padding: 8px 14px;
  border-radius: 999px;
  background: #dbeafe;
  color: var(--primary);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hero-panel h1 {
  margin: 20px 0 16px;
  font-size: clamp(2.8rem, 5vw, 4.4rem);
}

.hero-panel p {
  max-width: 620px;
  line-height: 1.7;
  color: var(--muted);
  font-size: 1.05rem;
}

.demo-roles {
  display: grid;
  gap: 12px;
  margin-top: 24px;
  max-width: 520px;
}

.role-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px 16px;
}

.role-item strong,
.role-item span,
.role-item small {
  display: block;
}

.role-item span {
  margin-top: 4px;
  color: var(--muted);
}

.form-panel {
  align-items: center;
}

.login-form {
  width: min(420px, 100%);
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid var(--border);
  border-radius: 20px;
  box-shadow: var(--shadow);
  padding: 28px 22px;
}

.login-form h2 {
  margin-bottom: 16px;
  font-size: 1.8rem;
}

.field {
  display: block;
  margin-bottom: 16px;
}

.field span {
  display: block;
  margin-bottom: 8px;
  font-weight: 700;
  color: #334155;
}

.field input,
.field select,
.field textarea {
  width: 100%;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 14px;
  background: white;
  color: var(--secondary);
}

.field input:focus,
.field select:focus,
.field textarea:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.12);
}

.btn {
  border: none;
  border-radius: 10px;
  padding: 11px 18px;
  font-weight: 700;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.btn:hover {
  transform: translateY(-1px);
}

.btn-primary {
  background: linear-gradient(135deg, var(--primary), #2563eb);
  color: white;
}

.btn-secondary {
  background: white;
  color: var(--secondary);
  border: 1px solid var(--border);
}

.full-width {
  width: 100%;
}

.dashboard-shell {
  display: flex;
  min-height: 100vh;
}

.sidebar {
  width: 260px;
  background: linear-gradient(180deg, #0f172a 0%, #111827 100%);
  color: #e2e8f0;
  padding: 24px 18px;
}

.sidebar h2 {
  margin-bottom: 26px;
  color: white;
  font-size: 1.5rem;
}

.sidebar nav {
  display: grid;
  gap: 8px;
}

.nav-link {
  display: block;
  padding: 10px 12px;
  border-radius: 10px;
  color: #dbeafe;
  font-weight: 600;
}

.nav-link:hover,
.nav-link.active {
  background: rgba(255, 255, 255, 0.08);
}

.workspace {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.85);
  border-bottom: 1px solid var(--border);
  padding: 18px 24px;
  backdrop-filter: blur(10px);
}

.eyebrow {
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--muted);
}

.topbar h1 {
  margin-top: 6px;
  font-size: 1.8rem;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 7px 12px;
  border-radius: 999px;
  background: #eff6ff;
  color: var(--primary-dark);
  font-size: 0.75rem;
  font-weight: 700;
}

.page-body {
  padding: 26px;
}

.kpi-grid,
.metric-grid,
.summary-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 18px;
}

.kpi-card,
.panel,
.metric-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 18px;
  box-shadow: var(--shadow);
}

.kpi-label,
.metric-label,
.section-label {
  display: block;
  font-size: 0.76rem;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 10px;
}

.kpi-value,
.metric-value {
  font-size: clamp(1.6rem, 2vw, 2.2rem);
  font-weight: 700;
}

.delta {
  display: inline-block;
  margin-top: 8px;
  font-size: 0.78rem;
  font-weight: 700;
}

.delta.positive {
  color: var(--success);
}

.delta.warning {
  color: var(--warning);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 18px;
}

.section-header h2,
.panel h3 {
  font-size: 1.5rem;
}

.panel h3 {
  margin-bottom: 14px;
}

.grid-two {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 18px;
  margin-top: 20px;
}

.chart-bars {
  height: 180px;
  display: flex;
  align-items: end;
  gap: 12px;
}

.bar {
  flex: 1;
  background: linear-gradient(180deg, #93c5fd 0%, #2563eb 100%);
  border-radius: 10px 10px 0 0;
  min-height: 20px;
}

.activity-list,
.list-plain {
  list-style: none;
  display: grid;
  gap: 12px;
}

.activity-item {
  display: flex;
  flex-direction: column;
  gap: 4px;
  border-bottom: 1px solid #edf2f7;
  padding-bottom: 10px;
}

.activity-item small,
.activity-item em {
  color: var(--muted);
}

.approval-stack {
  display: grid;
  gap: 12px;
}

.approval-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  border-radius: 12px;
  padding: 12px 14px;
  font-weight: 700;
}

.approval-item.success {
  background: var(--success-soft);
  color: var(--success);
}

.approval-item.warning {
  background: var(--warning-soft);
  color: var(--warning);
}

.approval-item.info {
  background: var(--info-soft);
  color: var(--info);
}

.table-wrap {
  overflow-x: auto;
}

.table {
  width: 100%;
  border-collapse: collapse;
}

.table th,
.table td {
  padding: 12px 10px;
  text-align: left;
  border-bottom: 1px solid #edf2f7;
}

.table thead th {
  background: #f8fafc;
  color: #475569;
}

.badge {
  display: inline-flex;
  padding: 5px 10px;
  border-radius: 999px;
  font-size: 0.72rem;
  font-weight: 700;
}

.badge.success {
  background: var(--success-soft);
  color: var(--success);
}

.badge.warning {
  background: var(--warning-soft);
  color: var(--warning);
}

.badge.info {
  background: #dbeafe;
  color: var(--primary-dark);
}

.badge.danger {
  background: var(--danger-soft);
  color: var(--danger);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
  margin-bottom: 18px;
}

.form-card {
  display: grid;
  gap: 18px;
}

.form-card .field { margin-bottom: 0; }

.empty-state {
  padding: 18px;
  color: var(--muted);
  background: #f8fafc;
  border-radius: 12px;
  border: 1px dashed var(--border);
}

@media (max-width: 980px) {
  .login-screen {
    grid-template-columns: 1fr;
  }

  .dashboard-shell {
    display: block;
  }

  .sidebar {
    width: 100%;
  }

  .grid-two {
    grid-template-columns: 1fr;
  }
}
