"use client";

import { useEffect, useState } from "react";
import { formatCurrency, getAppStore, type AppStore } from "@/lib/erp-data";

const emptyForm = {
  concept: "",
  type: "Ingreso",
  amount: "",
  date: new Date().toISOString().slice(0, 10),
};

export default function CajaPage() {
  const [store, setStore] = useState<AppStore | null>(null);
  const [form, setForm] = useState(emptyForm);

  useEffect(() => {
    setStore(getAppStore());
  }, []);

  if (!store) return null;

  const handleAdd = (event: React.FormEvent) => {
    event.preventDefault();
    if (!form.concept || !form.amount) {
      alert("Completa el concepto y monto.");
      return;
    }

    const movement = {
      id: `MV-${Date.now()}`,
      concept: form.concept,
      type: form.type,
      amount: Number(form.amount),
      date: form.date,
      status: "Aprobado",
    };

    const next = { ...store, cashMoves: [movement, ...store.cashMoves] };
    localStorage.setItem("farmacia-erp-store", JSON.stringify(next));
    setStore(next);
    setForm(emptyForm);
  };

  return (
    <>
      <div className="section-header">
        <h2>Caja</h2>
        <button className="btn btn-primary">Nuevo movimiento</button>
      </div>

      <section className="kpi-grid">
        <div className="kpi-card">
          <span className="kpi-label">Caja general</span>
          <div className="kpi-value">{formatCurrency(692500)}</div>
        </div>
        <div className="kpi-card">
          <span className="kpi-label">Caja chica</span>
          <div className="kpi-value">{formatCurrency(44120)}</div>
        </div>
        <div className="kpi-card">
          <span className="kpi-label">Diferencia</span>
          <div className="kpi-value">{formatCurrency(1480)}</div>
        </div>
      </section>

      <div className="grid-two">
        <div className="panel">
          <h3>Movimientos de caja</h3>
          <div className="table-wrap">
            <table className="table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Tipo</th>
                  <th>Concepto</th>
                  <th>Fecha</th>
                  <th>Monto</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody>
                {store.cashMoves.map((item) => (
                  <tr key={item.id}>
                    <td>{item.id}</td>
                    <td>{item.type}</td>
                    <td>{item.concept}</td>
                    <td>{item.date}</td>
                    <td>{formatCurrency(item.amount)}</td>
                    <td><span className="badge success">{item.status}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <div className="panel">
          <h3>Registrar movimiento</h3>
          <form className="form-card" onSubmit={handleAdd}>
            <label className="field">
              <span>Concepto</span>
              <input value={form.concept} onChange={(event) => setForm({ ...form, concept: event.target.value })} placeholder="Ventas del día" />
            </label>

            <div className="form-grid">
              <label className="field">
                <span>Tipo</span>
                <select value={form.type} onChange={(event) => setForm({ ...form, type: event.target.value })}>
                  <option value="Ingreso">Ingreso</option>
                  <option value="Egreso">Egreso</option>
                </select>
              </label>

              <label className="field">
                <span>Monto</span>
                <input type="number" value={form.amount} onChange={(event) => setForm({ ...form, amount: event.target.value })} placeholder="0.00" />
              </label>
            </div>

            <label className="field">
              <span>Fecha</span>
              <input type="date" value={form.date} onChange={(event) => setForm({ ...form, date: event.target.value })} />
            </label>

            <button className="btn btn-primary" type="submit">Guardar movimiento</button>
          </form>
        </div>
      </div>
    </>
  );
}

