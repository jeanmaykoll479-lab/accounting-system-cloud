"use client";

import { useEffect, useState } from "react";
import { formatCurrency, getAppStore, type AppStore } from "@/lib/erp-data";

export default function ReportesPage() {
  const [store, setStore] = useState<AppStore | null>(null);

  useEffect(() => {
    setStore(getAppStore());
  }, []);

  if (!store) return null;

  const grossProfit = store.sales.reduce((sum, item) => sum + item.total, 0) - store.purchases.reduce((sum, item) => sum + item.total, 0);

  const metrics = [
    { metric: "Margen bruto", value: "34.2%", trend: "+3.7%" },
    { metric: "Rotación de inventario", value: "11.4 días", trend: "-1.1 días" },
    { metric: "EBITDA", value: formatCurrency(540000), trend: "+7.9%" },
    { metric: "Utilidad neta", value: formatCurrency(grossProfit), trend: "+5.4%" },
  ];

  return (
    <>
      <div className="section-header">
        <h2>Reportes</h2>
        <button className="btn btn-primary">Exportar PDF</button>
      </div>

      <div className="panel">
        <h3>Indicadores financieros</h3>
        <div className="table-wrap">
          <table className="table">
            <thead>
              <tr>
                <th>Métrica</th>
                <th>Valor</th>
                <th>Tendencia</th>
              </tr>
            </thead>
            <tbody>
              {metrics.map((row) => (
                <tr key={row.metric}>
                  <td>{row.metric}</td>
                  <td>{row.value}</td>
                  <td><span className="badge success">{row.trend}</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </>
  );
}

