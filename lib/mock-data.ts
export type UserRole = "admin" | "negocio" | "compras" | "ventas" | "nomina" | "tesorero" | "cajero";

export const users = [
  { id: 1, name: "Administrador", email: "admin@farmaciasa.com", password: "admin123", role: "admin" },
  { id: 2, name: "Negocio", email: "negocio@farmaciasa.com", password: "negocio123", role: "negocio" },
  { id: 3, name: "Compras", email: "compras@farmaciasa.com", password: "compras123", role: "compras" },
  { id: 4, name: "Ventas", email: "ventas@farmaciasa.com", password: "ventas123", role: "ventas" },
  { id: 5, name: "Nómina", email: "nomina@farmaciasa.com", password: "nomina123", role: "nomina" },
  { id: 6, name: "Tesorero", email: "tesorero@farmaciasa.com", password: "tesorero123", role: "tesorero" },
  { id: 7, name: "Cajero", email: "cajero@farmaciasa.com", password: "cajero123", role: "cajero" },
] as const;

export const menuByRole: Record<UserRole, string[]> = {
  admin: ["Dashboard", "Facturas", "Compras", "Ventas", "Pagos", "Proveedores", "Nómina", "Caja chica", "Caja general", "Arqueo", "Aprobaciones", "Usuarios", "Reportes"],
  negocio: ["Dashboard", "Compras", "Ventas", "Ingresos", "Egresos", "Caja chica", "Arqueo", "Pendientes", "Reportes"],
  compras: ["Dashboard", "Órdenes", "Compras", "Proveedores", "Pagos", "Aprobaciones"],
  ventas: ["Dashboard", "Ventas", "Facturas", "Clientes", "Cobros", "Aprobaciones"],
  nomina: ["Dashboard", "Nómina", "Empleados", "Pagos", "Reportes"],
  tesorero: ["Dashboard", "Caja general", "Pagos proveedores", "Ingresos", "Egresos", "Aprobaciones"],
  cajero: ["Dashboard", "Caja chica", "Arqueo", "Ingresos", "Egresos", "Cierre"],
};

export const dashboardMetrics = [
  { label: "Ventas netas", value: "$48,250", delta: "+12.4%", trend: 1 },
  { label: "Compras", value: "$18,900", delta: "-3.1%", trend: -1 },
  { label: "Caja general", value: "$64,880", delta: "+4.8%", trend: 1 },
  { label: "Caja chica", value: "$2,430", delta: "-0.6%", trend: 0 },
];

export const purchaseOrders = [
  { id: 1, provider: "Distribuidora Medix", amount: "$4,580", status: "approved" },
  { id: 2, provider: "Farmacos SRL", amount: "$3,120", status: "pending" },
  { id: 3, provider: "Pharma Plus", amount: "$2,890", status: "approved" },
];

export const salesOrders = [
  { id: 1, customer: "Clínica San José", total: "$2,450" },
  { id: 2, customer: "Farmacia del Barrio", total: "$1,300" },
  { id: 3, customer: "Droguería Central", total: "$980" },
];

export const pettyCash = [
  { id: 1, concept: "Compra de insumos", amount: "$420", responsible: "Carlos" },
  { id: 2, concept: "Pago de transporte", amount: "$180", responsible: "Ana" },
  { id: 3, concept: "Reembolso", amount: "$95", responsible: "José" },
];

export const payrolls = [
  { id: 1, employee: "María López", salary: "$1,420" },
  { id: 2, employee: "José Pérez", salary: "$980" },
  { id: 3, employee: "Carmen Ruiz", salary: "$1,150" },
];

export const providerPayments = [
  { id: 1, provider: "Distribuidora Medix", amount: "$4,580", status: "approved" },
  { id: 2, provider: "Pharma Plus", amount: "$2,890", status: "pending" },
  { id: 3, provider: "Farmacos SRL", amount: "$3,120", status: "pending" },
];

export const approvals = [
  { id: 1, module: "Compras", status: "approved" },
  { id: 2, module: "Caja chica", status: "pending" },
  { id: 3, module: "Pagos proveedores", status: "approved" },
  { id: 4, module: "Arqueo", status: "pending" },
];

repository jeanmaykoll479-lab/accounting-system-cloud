"use client";

import { useEffect, useMemo, useState } from "react";
import {
  dashboardMetrics,
  menuByRole,
  purchaseOrders,
  salesOrders,
  pettyCash,
  approvals,
  payrolls,
  providerPayments,
} from "@/lib/mock-data";

export default function DashboardPage() {
  const [user, setUser] = useState<any>(null);

  useEffect(() => {
    const stored = localStorage.getItem("farmacia_user");
    if (stored) {
      setUser(JSON.parse(stored));
    }
  }, []);

  const menu = useMemo(() => {
    if (!user) return [];
    return menuByRole[user.role] ?? menuByRole.admin;
  }, [user]);

  if (!user) {
    return <div className="page-shell">Cargando dashboard...</div>;
  }

  return (
    <main className="dashboard-page">
      <aside className="sidebar">
        <h2>Farmacia S.A.</h2>
        <nav>
          {menu.map((item) => (
            <a key={item} href="#">{item}</a>
          ))}
        </nav>
      </aside>

      <section className="content">
        <div className="topbar">
          <div>
            <strong>Bienvenido</strong>
            <div>{user.name}</div>
          </div>
          <div className="badge">Rol: {user.role}</div>
        </div>

        <div className="page-shell">
          <div className="kpis">
            {dashboardMetrics.map((metric) => (
              <div
                key={metric.label}
                className={`kpi ${metric.trend > 0 ? "positive" : metric.trend < 0 ? "danger" : "warning"}`}
              >
                <span className="label">{metric.label}</span>
                <span className="value">{metric.value}</span>
                <span className="delta">{metric.delta}</span>
              </div>
            ))}
          </div>

          <div className="grid-two">
            <div className="panel">
              <h3>Órdenes de compra</h3>
              <table className="table">
                <thead>
                  <tr>
                    <th>Proveedor</th>
                    <th>Monto</th>
                    <th>Estado</th>
                  </tr>
                </thead>
                <tbody>
                  {purchaseOrders.map((item) => (
                    <tr key={item.id}>
                      <td>{item.provider}</td>
                      <td>{item.amount}</td>
                      <td>
                        <span className={`status-pill status-${item.status}`}>{item.status}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div className="panel">
              <h3>Ventas del día</h3>
              <table className="table">
                <thead>
                  <tr>
                    <th>Cliente</th>
                    <th>Total</th>
                  </tr>
                </thead>
                <tbody>
                  {salesOrders.map((item) => (
                    <tr key={item.id}>
                      <td>{item.customer}</td>
                      <td>{item.total}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div className="grid-two">
            <div className="panel">
              <h3>Caja chica</h3>
              <table className="table">
                <thead>
                  <tr>
                    <th>Concepto</th>
                    <th>Importe</th>
                    <th>Responsable</th>
                  </tr>
                </thead>
                <tbody>
                  {pettyCash.map((item) => (
                    <tr key={item.id}>
                      <td>{item.concept}</td>
                      <td>{item.amount}</td>
                      <td>{item.responsible}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div className="panel">
              <h3>Nómina</h3>
              <table className="table">
                <thead>
                  <tr>
                    <th>Empleado</th>
                    <th>Salario</th>
                  </tr>
                </thead>
                <tbody>
                  {payrolls.map((item) => (
                    <tr key={item.id}>
                      <td>{item.employee}</td>
                      <td>{item.salary}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>

          <div className="grid-two">
            <div className="panel">
              <h3>Pagos a proveedores</h3>
              <table className="table">
                <thead>
                  <tr>
                    <th>Proveedor</th>
                    <th>Importe</th>
                    <th>Estado</th>
                  </tr>
                </thead>
                <tbody>
                  {providerPayments.map((item) => (
                    <tr key={item.id}>
                      <td>{item.provider}</td>
                      <td>{item.amount}</td>
                      <td>
                        <span className={`status-pill status-${item.status}`}>{item.status}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div className="panel">
              <h3>Aprobaciones</h3>
              <table className="table">
                <thead>
                  <tr>
                    <th>Módulo</th>
                    <th>Estado</th>
                  </tr>
                </thead>
                <tbody>
                  {approvals.map((item) => (
                    <tr key={item.id}>
                      <td>{item.module}</td>
                      <td>
                        <span className={`status-pill status-${item.status}`}>{item.status}</span>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    </main>
  );
}
